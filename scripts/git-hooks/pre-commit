#!/usr/bin/env bash
# quant-web 提交前脱敏检查（pre-commit hook）
#
# 激活方式（一次性，写入本地 .git/config，不随仓库分发）：
#   git config core.hooksPath scripts/git-hooks
#
# 两道闸：
#   1) 硬阻断 —— 敏感文件类型 + 已知密钥格式（见下方清单）
#   2) 硬阻断 —— 新增行中出现生产服务器 / 内网地址
#      （2026-10-19 仓库已完成地址脱敏，故 IP 一并硬阻断；
#       如需临时放宽改 WARN_ONLY_IP=1）
#
# 说明：本 hook 只检查「本次暂存的内容」，已入库的历史不在职责范围；
# 历史泄露用 git filter-repo / BFG 重写 + 密钥轮换处理（见 README §十）。

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

RED=$'\033[31m'; YEL=$'\033[33m'; GRN=$'\033[32m'; OFF=$'\033[0m'
BLOCK=0
WARN=0
WARN_ONLY_IP=0   # 仓库已完成服务器地址脱敏（2026-10-19），IP 一律硬阻断；1=仅警告

err()  { echo "${RED}✗ $*${OFF}" >&2; BLOCK=1; }
warn() { echo "${YEL}⚠ $*${OFF}" >&2; WARN=1; }

# ---------------------------------------------------------------- 1. 敏感文件类型
# 按暂存区文件名单检查（新增/改名/修改/复制都算）
BAD_EXT='\.(db|sqlite|sqlite3|env|secret|pem|key|p12|pfx|crt|cer|der|keystore|jks|id_rsa|id_ed25519)$'
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
while IFS= read -r f; do
  [ -z "$f" ] && continue
  base="$(basename "$f")"
  if echo "$base" | grep -qiE "$BAD_EXT"; then
    err "敏感文件类型被暂存：$f"
    echo "    数据库/私钥/证书一律不入库；.gitignore 已覆盖，如确需提交请先人工复核内容。" >&2
  fi
  # 常见密钥文件名（无扩展名或名字即密钥）
  case "$base" in
    .env|.env.*|*credentials*|*secrets*|id_rsa|id_ed25519|*.keystore)
      err "疑似密钥文件被暂存：$f" ;;
  esac
done <<< "$staged_files"

# ---------------------------------------------------------------- 2. 密钥格式（新增行）
# 只扫本次新增/修改的行（以暂存区 diff 为准），历史内容不误伤
SECRET_PATTERNS=(
  'sk-[A-Za-z0-9_-]{20,}'              # OpenAI / DeepSeek / Moonshot / 智谱 等
  'ghp_[A-Za-z0-9]{36}'                # GitHub Personal Access Token
  'github_pat_[A-Za-z0-9_]{22,}'       # GitHub fine-grained PAT
  'glpat-[A-Za-z0-9_-]{20,}'           # GitLab PAT
  'AKIA[0-9A-Z]{16}'                   # AWS Access Key ID
  'ASIA[0-9A-Z]{16}'                   # AWS 临时密钥
  'xox[baprs]-[A-Za-z0-9-]{10,}'       # Slack token
  'AIza[0-9A-Za-z_-]{35}'              # Google API key
  'ya29\.[0-9A-Za-z_-]{20,}'           # Google OAuth access token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----' # PEM 私钥
  'Bearer [A-Za-z0-9_-]{24,}'          # 写死的 Bearer 令牌（非代码拼接）
)
added_lines="$(git diff --cached -U0 | grep '^+' | grep -v '^+++' || true)"
if [ -n "$added_lines" ]; then
  for pat in "${SECRET_PATTERNS[@]}"; do
    hit="$(echo "$added_lines" | grep -nE -e "$pat" | head -3 || true)"
    if [ -n "$hit" ]; then
      err "暂存内容命中密钥格式 /$pat/："
      echo "$hit" | sed 's/^/    /' >&2
    fi
  done
fi

# ---------------------------------------------------------------- 3. 服务器 / 内网地址（硬阻断）
# 生产 VPS 与本机内网段：公开仓库里出现会招来扫描与爆破。
# ⚠️ 本文件自身含 IPv6 前缀片段（拆两段书写）——这是检测器的必要成本，属已知且受控的
# 暴露：完整主机地址（::47）与 /64 前缀均不以连续字面量出现在本文件，前缀也不可路由到主机。
PROD_V6_A="2404:8c80:82:1057"
PROD_V6_B="::47"
IP_PATTERNS=(
  "${PROD_V6_A}${PROD_V6_B}"   # 生产 VPS（IPv6 主机地址）
  "${PROD_V6_A}::/64"          # 生产 VPS 网段前缀
  '\b47\.110\.153\.9\b'        # inkspcl / pywork VPS（IPv4）
  '\b67\.215\.237\.94\b'       # RackNerd VPS（IPv4）
  '\b172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}\b'  # docker bridge 段
)
for pat in "${IP_PATTERNS[@]}"; do
  hit="$(echo "$added_lines" | grep -nE -e "$pat" | head -3 || true)"
  if [ -n "$hit" ]; then
    if [ "$WARN_ONLY_IP" = "1" ]; then
      warn "新增行中出现服务器 / 内网地址（/$pat/）——公开仓库建议改占位符："
      echo "$hit" | sed 's/^/    /' >&2
    else
      err "新增行中出现服务器 / 内网地址（/$pat/）——仓库已声明脱敏，禁止再入库："
      echo "$hit" | sed 's/^/    /' >&2
    fi
  fi
done

# ---------------------------------------------------------------- 结论
if [ "$BLOCK" = "1" ]; then
  echo "" >&2
  echo "${RED}提交已被脱敏检查拦截。${OFF}" >&2
  echo "  确认无敏感内容后，用 git reset 取消暂存、删除或改写相关文件再提交。" >&2
  echo "  紧急情况下可 git commit --no-verify 跳过（不推荐，CI 侧仍会扫）。" >&2
  exit 1
fi
if [ "$WARN" = "1" ]; then
  echo "${YEL}脱敏检查通过（有警告，请人工确认上述地址是否可以公开）。${OFF}"
else
  echo "${GRN}脱敏检查通过。${OFF}"
fi
exit 0
